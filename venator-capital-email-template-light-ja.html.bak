    .tagline{ font-size:16px; color:#6B7280; margin:12px 0 0 0; font-weight:500; }
    .hero{ background:#FFFFFF; padding:64px 24px 56px; text-align:center; border-bottom:1px solid #E5E7EB; }
    .badge{ display:inline-block; background:#1D4ED8; color:#FFFFFF; padding:12px 20px; border-radius:24px; font-size:13px; font-weight:700; letter-spacing:.08em; border:none; text-transform:uppercase; }
    .hero-title{ font-size:32px; font-weight:800; margin:20px 0 16px; line-height:1.3; letter-spacing:.01em; color:#1F2937; }
    .hero-sub{ font-size:18px; color:#374151; max-width:540px; margin:0 auto 24px; line-height:1.6; }

    .meta-note{ font-size:14px; color:#6B7280; margin-top:16px; }
    .stats{ background:#F8FAFC; padding:40px 24px; text-align:center; border-bottom:1px solid #E5E7EB; }

    .section{ padding:64px 24px; background:#FFFFFF; }
    .section.alt{ background:#F8FAFC; border-bottom:1px solid #E5E7EB; }
    .title{ font-size:26px; font-weight:800; text-align:center; margin:0 0 48px; color:#1F2937; line-height:1.3; }
    .card{ background:#FFFFFF; border:1px solid #E5E7EB; border-radius:16px; }
    .card .inner{ padding:24px 20px; color:#1A1A1A; }
    .card h4{ font-size:18px; margin:0 0 8px; font-weight:700; color:#1F2937; }
    .card p{ font-size:15px; color:#374151; margin:0; line-height:1.6; }

    .footer{ background:#F1F5F9; padding:48px 24px; border-top:1px solid #E5E7EB; }
    .footer p{ font-size:16px; color:#374151; text-align:center; margin:0 0 24px; line-height:1.6; }
