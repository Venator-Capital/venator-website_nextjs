    <!-- Objections (FAQ) -->
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0">
            <tr>
              <td class="section" style="padding:64px 24px;background:#FFFFFF;border-top:1px solid #E5E7EB;">
                <table role="presentation" width="60" align="center" cellpadding="0" cellspacing="0" style="height:3px;background:#1D4ED8;border-radius:2px;margin-bottom:32px;"><tr><td style="font-size:0;line-height:0;">&nbsp;</td></tr></table>
                <h3 class="title" style="font-size:26px;font-weight:800;text-align:center;margin:0 0 32px;color:#1F2937;line-height:1.3;">よくある懸念への回答</h3>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;margin:0 auto;">
                  <tr>
                    <td style="padding:12px;">
                      <table role="presentation" width="100%" style="background:#F8FAFC;border:1px solid #E5E7EB;border-radius:12px;">
                        <tr><td style="padding:16px 20px;">
                          <p style="margin:0 0 6px;color:#111827;font-weight:700;">Q. 既存システムに手を入れたくない</p>
                          <p style="margin:0;color:#374151;">A. 既存資産の再活用を前提に構成。必要に応じて<strong>疎結合の接続</strong>（API・バッチ）で段階導入します。</p>
                        </td></tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:12px;">
                      <table role="presentation" width="100%" style="background:#F8FAFC;border:1px solid #E5E7EB;border-radius:12px;">
                        <tr><td style="padding:16px 20px;">
                          <p style="margin:0 0 6px;color:#111827;font-weight:700;">Q. セキュリティ・監査が心配</p>
                          <p style="margin:0;color:#374151;">A. SOC 2／ISO 27001の要件を前提に<strong>データ分類・権限分離・監査ログ</strong>を初期から設計します。</p>
                        </td></tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:12px;">
                      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;margin:0 auto;">
                        <tr>
                          <td style="padding:12px;">
                            <table role="presentation" width="100%" style="background:#F8FAFC;border:1px solid #E5E7EB;border-radius:12px;">
                              <tr><td style="padding:16px 20px;">
                                <p style="margin:0 0 6px;color:#111827;font-weight:700;">Q. ROIが見えないと稟議が通らない</p>
                                <p style="margin:0;color:#374151;">A. 2週間で<strong>検証結果と運用コスト見込み</strong>を提示し、投資継続の可否判断に必要な資料を揃えます。</p>
                              </td></tr>
                            </table>
                          </td>
                        </tr>
                        <tr>
                          <td style="padding:12px;">
                            <table role="presentation" width="100%" style="background:#F8FAFC;border:1px solid #E5E7EB;border-radius:12px;">
                              <tr><td style="padding:16px 20px;">
                                <p style="margin:0 0 6px;color:#111827;font-weight:700;">Q. 現場の負担が増えるのでは？</p>
                                <p style="margin:0;color:#374151;">A. 初期は<strong>小さく始める自動化</strong>に限定。現場のレビュー時間は最小限に抑えます。</p>
                              </td></tr>
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>
