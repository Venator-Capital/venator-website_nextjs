{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop",
        "screenEmulation": { "mobile": false, "width": 1350, "height": 940, "deviceScaleRatio": 1, "disabled": false },
        "throttling": { "rttMs": 40, "throughputKbps": 10240, "cpuSlowdownMultiplier": 1 },
        "skipAudits": ["uses-http2"]
      },
      "url": [
        "https://venator-website-nextjs.vercel.app/",
        "https://venator-website-nextjs.vercel.app/ai-workflows"
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "reports/lighthouse/mobile"
    }
  }
}
